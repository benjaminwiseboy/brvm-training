# Copier en .env.local et remplir avec les clés du projet Supabase
# (Project Settings → API). Le schéma (tables, RLS, policies) vit dans
# supabase/migrations/ — déployé automatiquement par l'intégration
# GitHub à chaque push, ou via `npx supabase db push` en local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète — jamais exposée au navigateur, utilisée uniquement
# côté serveur (migration de la progression locale à l'inscription).
SUPABASE_SERVICE_ROLE_KEY=

# Utilisé pour construire les liens de confirmation email / reset mot de
# passe (emailRedirectTo). Sans cette variable : http://localhost:3000
# (OK en dev). À définir en prod avec l'URL réelle du site.
NEXT_PUBLIC_SITE_URL=
